{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "regions": [
    "cdg1"
  ],
  "crons": [
    {
      "path": "/api/mail/sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/mail/invoices",
      "schedule": "30 6 * * *"
    }
  ]
}
